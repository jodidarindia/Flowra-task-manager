 <!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>FLOWRA Tasks | Smart Team Execution Platform</title>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
<link rel="icon" type="image/x-icon" href="{{ url_for('static', filename='flowra_favicon.ico') }}">

<style>
*{margin:0;padding:0;box-sizing:border-box;font-family:'Poppins',sans-serif}
body{background:#eef4ff;color:#0f172a;overflow-x:hidden}
.hero-bg{min-height:100vh;background:radial-gradient(circle at 25% 35%,#6ee7f9 0,transparent 32%),radial-gradient(circle at 85% 30%,#c4b5fd 0,transparent 35%),linear-gradient(135deg,#eaf2ff,#f8f7ff);position:relative;overflow:hidden}
.hero-bg::before{content:"";position:absolute;inset:0;background-image:linear-gradient(rgba(37,99,235,.08) 1px,transparent 1px),linear-gradient(90deg,rgba(37,99,235,.08) 1px,transparent 1px);background-size:70px 70px}
.navbar{height:78px;background:rgba(255,255,255,.78);backdrop-filter:blur(18px);border-bottom:1px solid rgba(15,23,42,.08)}
.logo-img{height:42px;width:42px;border-radius:12px;box-shadow:0 10px 28px rgba(37,99,235,.22)}
.brand-text{font-size:28px;font-weight:900;letter-spacing:-1px;color:#0f172a}
.nav-link{font-weight:800;color:#475569!important;margin:0 14px}
.nav-link:hover{color:#2563eb!important}
.login-outline{border:1px solid #cbd5e1;border-radius:16px;padding:12px 26px;font-weight:900;text-decoration:none;color:#0f172a;background:white}
.get-started{border-radius:16px;padding:12px 28px;font-weight:900;text-decoration:none;color:white;background:linear-gradient(135deg,#2563eb,#7c3aed);box-shadow:0 18px 45px rgba(37,99,235,.28)}
.hero{position:relative;z-index:1;padding:95px 0 70px}
.badge-live{display:inline-flex;align-items:center;gap:10px;background:rgba(255,255,255,.75);border:1px solid rgba(37,99,235,.18);border-radius:999px;padding:11px 18px;font-size:13px;font-weight:900;color:#2563eb;letter-spacing:3px;margin-bottom:26px;box-shadow:0 18px 45px rgba(37,99,235,.12)}
.dot{width:10px;height:10px;background:#22c55e;border-radius:50%;box-shadow:0 0 18px #22c55e}
.hero h1{font-size:clamp(3.6rem,7vw,6.2rem);line-height:.98;font-weight:900;letter-spacing:-4px;color:#07111f;margin-bottom:24px}
.hero h1 span{display:block;background:linear-gradient(135deg,#2563eb,#7c3aed,#06b6d4);-webkit-background-clip:text;color:transparent}
.hero p{font-size:18px;line-height:1.8;color:#475569;max-width:590px}
.hero-actions{display:flex;gap:16px;flex-wrap:wrap;margin-top:34px}
.primary-btn{background:linear-gradient(135deg,#2563eb,#7c3aed);color:#fff;text-decoration:none;border-radius:18px;padding:15px 32px;font-weight:900;box-shadow:0 22px 55px rgba(37,99,235,.30)}
.secondary-btn{background:#fff;color:#0f172a;text-decoration:none;border-radius:18px;padding:15px 32px;font-weight:900;border:1px solid #dbe3ef}
.browser-card{background:#fff;border-radius:28px;box-shadow:0 35px 100px rgba(37,99,235,.22);overflow:hidden;border:1px solid rgba(15,23,42,.08)}
.browser-top{height:48px;background:#111827;display:flex;align-items:center;padding:0 20px;gap:9px;color:#cbd5e1;font-size:13px}
.circle{width:12px;height:12px;border-radius:50%}
.red{background:#fb7185}.yellow{background:#fbbf24}.green{background:#22c55e}
.dashboard{display:grid;grid-template-columns:155px 1fr;background:#f8fafc;min-height:410px}
.side{background:#eef3fb;padding:24px 14px}
.side-item{padding:14px 16px;border-radius:14px;font-weight:900;color:#64748b;margin-bottom:12px}
.side-item.active{background:linear-gradient(135deg,#2563eb,#7c3aed);color:white;box-shadow:0 14px 35px rgba(37,99,235,.25)}
.dash-main{padding:26px}
.dash-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:22px}
.dash-head h3{font-weight:900}
.year-pill{border:1px solid #dbe3ef;border-radius:12px;padding:8px 12px;color:#64748b;font-weight:700}
.metric-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}
.metric{background:#fff;border:1px solid #e2e8f0;border-radius:18px;padding:18px}
.metric small{font-weight:900;color:#94a3b8;display:block;line-height:1.1}
.metric h4{font-weight:900;margin-top:10px}
.blue-t{color:#2563eb}.purple-t{color:#7c3aed}.red-t{color:#dc2626}
.activity{background:#fff;border:1px solid #e2e8f0;border-radius:20px;padding:20px;margin-top:16px}
.activity h5{font-weight:900;margin-bottom:16px}
.activity-row{display:flex;justify-content:space-between;margin:10px 0;color:#334155}
.activity-row b{color:#2563eb}
.features{padding:90px 0;background:#fff}
.section-title{font-size:clamp(2.3rem,4vw,4rem);font-weight:900;letter-spacing:-2px;text-align:center}
.section-subtitle{text-align:center;color:#64748b;max-width:720px;margin:16px auto 50px;line-height:1.8}
.feature-card{background:#f8fafc;border:1px solid #e2e8f0;border-radius:28px;padding:34px;height:100%;transition:.3s}
.feature-card:hover{transform:translateY(-10px);box-shadow:0 30px 70px rgba(37,99,235,.15)}
.icon{height:66px;width:66px;border-radius:22px;background:linear-gradient(135deg,#2563eb,#7c3aed);display:grid;place-items:center;color:white;font-size:30px;margin-bottom:22px}
.feature-card h4{font-weight:900}
.feature-card p{color:#64748b;line-height:1.7}
.stats{padding:80px 0;background:linear-gradient(135deg,#eff6ff,#f5f3ff)}
.stats h2{font-size:3rem;font-weight:900;color:#2563eb}
.stats p{font-weight:800;color:#64748b}
.cta{padding:90px 0;background:#fff}
.cta-box{border-radius:34px;padding:58px;background:linear-gradient(135deg,#2563eb,#7c3aed);color:white;text-align:center;box-shadow:0 35px 100px rgba(37,99,235,.25)}
.cta-box h2{font-weight:900;font-size:clamp(2rem,4vw,3.5rem)}
.cta-box p{color:#e0e7ff}
.cta-box a{background:white;color:#2563eb;text-decoration:none;border-radius:18px;padding:15px 34px;font-weight:900;display:inline-block;margin-top:20px}
footer{background:#0f172a;color:#94a3b8;text-align:center;padding:28px;font-weight:700}
@media(max-width:991px){.dashboard{grid-template-columns:1fr}.side{display:none}.hero h1{letter-spacing:-2px}.browser-card{margin-top:40px}.nav-center{display:none}}
@media(max-width:768px){.metric-grid{grid-template-columns:1fr}.hero{padding-top:70px}.hero h1{font-size:3.4rem}.navbar{height:auto;padding:14px 0}.brand-text{font-size:22px}}
</style>
</head>

<body>

<div class="hero-bg">

<nav class="navbar navbar-expand-lg">
    <div class="container d-flex align-items-center justify-content-between">
        <a class="d-flex align-items-center gap-2 text-decoration-none" href="#">
            <img class="logo-img" src="{{ url_for('static', filename='images/flowra(2).png') }}" alt="FLOWRA">
            <span class="brand-text">FLOWRA</span>
        </a>

        <div class="nav-center">
            <a class="nav-link d-inline-block" href="#features">Features</a>
            <a class="nav-link d-inline-block" href="#stats">Analytics</a>
            <a class="nav-link d-inline-block" href="#security">Security</a>
            <a class="nav-link d-inline-block" href="#support">Support</a>
        </div>

        <div class="d-flex gap-3">
            <a class="login-outline" href="{{ url_for('main.login') }}">Login</a>
            <a class="get-started" href="{{ url_for('main.login') }}">Get Started</a>
        </div>
    </div>
</nav>

<section class="hero">
    <div class="container">
        <div class="row align-items-center g-5">
            <div class="col-lg-6">
                <div class="badge-live">
                    <span class="dot"></span>
                    FLOWRA TASK PLATFORM
                </div>

                <h1>
                    Power your
                    <span>Team Workflow</span>
                </h1>

                <p>
                    Assign tasks, monitor employees, approve work, track time,
                    automate reminders and manage productivity from one smart business dashboard.
                </p>

                <div class="hero-actions">
                    <a class="primary-btn" href="{{ url_for('main.login') }}">Start Managing Tasks →</a>
                    <a class="secondary-btn" href="#features">Explore Features</a>
                </div>
            </div>

            <div class="col-lg-6">
                <div class="browser-card">
                    <div class="browser-top">
                        <span class="circle red"></span>
                        <span class="circle yellow"></span>
                        <span class="circle green"></span>
                        <span class="ms-auto">flowra.in/dashboard</span>
                    </div>

                    <div class="dashboard">
                        <div class="side">
                            <div class="side-item active">Dashboard</div>
                            <div class="side-item">Tasks</div>
                            <div class="side-item">Employees</div>
                            <div class="side-item">Analytics</div>
                            <div class="side-item">Reports</div>
                        </div>

                        <div class="dash-main">
                            <div class="dash-head">
                                <h3>Task Overview</h3>
                                <div class="year-pill">Live Today</div>
                            </div>

                            <div class="metric-grid">
                                <div class="metric">
                                    <small>Total Tasks</small>
                                    <h4 class="blue-t">128</h4>
                                </div>
                                <div class="metric">
                                    <small>Active Users</small>
                                    <h4 class="purple-t">24</h4>
                                </div>
                                <div class="metric">
                                    <small>Pending</small>
                                    <h4 class="red-t">09</h4>
                                </div>
                            </div>

                            <div class="activity">
                                <h5>Recent Activity</h5>
                                <div class="activity-row"><span>Tasks completed</span><b>+42</b></div>
                                <div class="activity-row"><span>New assignments</span><b>+18</b></div>
                                <div class="activity-row"><span>Reminders triggered</span><b>+31</b></div>
                                <div class="activity-row"><span>Approvals done</span><b>+15</b></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</section>

</div>

<section class="features" id="features">
    <div class="container">
        <h2 class="section-title">Everything your team needs</h2>
        <p class="section-subtitle">
            FLOWRA Tasks is designed for admins, managers and employees to work faster with complete visibility.
        </p>

        <div class="row g-4">
            <div class="col-md-4">
                <div class="feature-card">
                    <div class="icon">✅</div>
                    <h4>Task Assignment</h4>
                    <p>Create tasks, assign employees, set priorities, add due dates, and track completion status live.</p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="feature-card">
                    <div class="icon">📊</div>
                    <h4>Productivity Analytics</h4>
                    <p>See completed, pending and overdue work with employee-wise performance and reward points.</p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="feature-card">
                    <div class="icon">🔔</div>
                    <h4>Smart Reminders</h4>
                    <p>Daily reminders, recurring tasks and deadline alerts keep every team member on track.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="stats" id="stats">
    <div class="container">
        <div class="row text-center g-4">
            <div class="col-md-3"><h2>3</h2><p>Role Dashboards</p></div>
            <div class="col-md-3"><h2>24/7</h2><p>Live Monitoring</p></div>
            <div class="col-md-3"><h2>AI</h2><p>Task Suggestions</p></div>
            <div class="col-md-3"><h2>PDF</h2><p>Excel Reports</p></div>
        </div>
    </div>
</section>

<section class="cta" id="support">
    <div class="container">
        <div class="cta-box">
            <h2>Ready to run your team smarter?</h2>
            <p class="mt-3">Login to FLOWRA Tasks and start managing work with clarity.</p>
            <a href="{{ url_for('main.login') }}">Login to Dashboard →</a>
        </div>
    </div>
</section>

<footer>
    © 2026 FLOWRA Tasks · Jodidar India Pvt Ltd
</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>

